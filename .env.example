# ── Core ────────────────────────────────────────────────────────
APP_SECRET=               # Long random string — signs session cookies (JWT). Keep secret.
                          # Must be at least 32 characters in production.
TOTP_SECRET=              # Separate secret for 2FA login challenges. Optional; falls back to
                          # APP_SECRET, but should be a distinct high-entropy value in production.
DATABASE_URL=             # MySQL connection string: mysql://user:pass@host:3306/ehive
                          # On Railway, set this to ${{ MySQL.MYSQL_URL }}
DATABASE_SSL=             # "true" only for external managed DBs that require TLS
                          # (PlanetScale, RDS, etc.). Leave empty for Railway/local.

# ── Public URL ─────────────────────────────────────────────────
PUBLIC_URL=               # Public base URL of the deployment, e.g. https://www.ehiveglobal.com
                          # REQUIRED in production when serving on a custom domain — it drives
                          # email/reset links, Stripe redirect URLs, CORS and robots.txt/sitemap.
                          # When unset, falls back to the known-live railway origin.

# ── First admin ─────────────────────────────────────────────────
OWNER_EMAIL=              # The account that registers with this email is auto-granted admin

# ── Email — optional. Leave blank to disable outbound mail. ──
# When set, every website lead is emailed to LEAD_NOTIFY_EMAIL and the person
# who submitted the form gets a confirmation. Leads are still stored either way.
#
# Preferred: Zoho ZeptoMail over HTTPS — works even where the host blocks
# outbound SMTP ports (e.g. Railway). Set the token and it takes priority over
# SMTP. Get it from ZeptoMail → Mail Agent → Setup Info → "Send Mail Token".
ZEPTOMAIL_TOKEN=          # e.g. Zoho-enczapikey <long token> — paste only the token value
ZEPTOMAIL_API_URL=        # optional; default https://api.zeptomail.com/v1.1/email (.eu for EU DC)
#
# Alternative: classic SMTP (only if the host allows outbound 587/465).
SMTP_HOST=                # e.g. smtppro.zoho.com, smtp.gmail.com, email-smtp.<region>.amazonaws.com
SMTP_PORT=587             # 587 (STARTTLS) or 465 (implicit TLS)
SMTP_SECURE=              # "true" for port 465; leave empty for 587
SMTP_USER=                # SMTP username / full email address
SMTP_PASS=                # SMTP password or app-password (Gmail/Zoho: create an App Password)
MAIL_FROM=                # From: address — must be a verified sender, e.g. info@ehiveglobal.com
LEAD_NOTIFY_EMAIL=        # Where new-lead alerts go (defaults to OWNER_EMAIL)
PARTNERS_NOTIFY_EMAIL=    # Dedicated inbox for partner enquiries (falls back to LEAD_NOTIFY_EMAIL)
FRANCHISE_NOTIFY_EMAIL=   # Dedicated inbox for franchise enquiries (falls back to LEAD_NOTIFY_EMAIL)

# ── Payments (Stripe) — optional. Leave blank to disable online payment. ──
# When set, tiers in SELF_SERVE_TIERS (contracts/constants.ts) can be joined and
# paid online; membership activates automatically once payment clears. While
# VANGUARD_FOUNDING_APPLICATION_ONLY is true, every tier is application-only
# and payment is recorded manually after admission.
STRIPE_SECRET_KEY=        # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=    # whsec_… — from the Stripe webhook endpoint (see DEPLOY.md)

# ── Operations & monitoring — all optional ─────────────────────
METRICS_TOKEN=            # Bearer token for GET /api/metrics — in production the endpoint
                          # is disabled without it; elsewhere it is checked when set
SENTRY_DSN=               # Posts lightweight events to Sentry's store API
ALERT_WEBHOOK_URL=        # Receives a JSON payload when operational alerts fire
CLAMAV_URL=               # ClamAV REST endpoint for receipt malware scanning
                          # (empty = only magic-byte validation, logged as un-scanned)
CLAMAV_TOKEN=             # Bearer token for the ClamAV endpoint

# ── Integration API — optional ─────────────────────────────────
# Read-only API (/api/integrations/v1/*) for an external ERP / accounting app to poll.
# Format per key: <random-key> (legacy, full access) or <name>:<scopes>:<random-key>;
# comma-separate multiple keys to allow rotation. Empty = integration API disabled (503).
INTEGRATION_API_KEYS=

# ── Rate limits & runtime tuning — defaults are built in ───────
TRPC_MUTATION_RATE_LIMIT= # Per-user authenticated tRPC mutations/min (default 120)
TRPC_QUERY_RATE_LIMIT=    # Per-user authenticated tRPC queries/min (default 600)
DB_POOL_SIZE=             # MySQL connection pool size (default 20)
PORT=                     # HTTP port to bind (default 3000; Railway injects this automatically)
CSP_REPORT_ONLY=          # "true" sends Content-Security-Policy as Report-Only (use while
                          # migrating away from 'unsafe-inline' for style-src)

# ── Demo data — local development only ─────────────────────────
ALLOW_DEMO_DATA=          # "true" lets the "Load full demo" admin endpoint run under
                          # NODE_ENV=production. NEVER set on a paid/production environment —
                          # demo accounts use the public password ehive1234.

# ── Bundled MySQL (docker-compose only; ignore if using a managed DB) ──
MYSQL_DATABASE=ehive      # Database name created in the db container
MYSQL_USER=ehive          # Application DB user
MYSQL_PASSWORD=           # Password for MYSQL_USER (used in DATABASE_URL)
MYSQL_ROOT_PASSWORD=      # MySQL root password
APP_PORT=3000             # Host port to expose the app on
