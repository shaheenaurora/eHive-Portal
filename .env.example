# ── Core ────────────────────────────────────────────────────────
APP_SECRET=               # Long random string — signs session cookies (JWT). Keep secret.
DATABASE_URL=             # MySQL connection string: mysql://user:pass@host:3306/ehive
                          # On Railway, set this to ${{ MySQL.MYSQL_URL }}
DATABASE_SSL=             # "true" only for external managed DBs that require TLS
                          # (PlanetScale, RDS, etc.). Leave empty for Railway/local.

# ── First admin ─────────────────────────────────────────────────
OWNER_EMAIL=              # The account that registers with this email is auto-granted admin

# ── Email — optional. Leave blank to disable outbound mail. ──
# When set, every website lead is emailed to LEAD_NOTIFY_EMAIL and the person
# who submitted the form gets a confirmation. Leads are still stored either way.
#
# Preferred: Zoho ZeptoMail over HTTPS — works even where the host blocks
# outbound SMTP ports (e.g. Railway). Set the token and it takes priority over
# SMTP. Get it from ZeptoMail → Mail Agent → Setup Info → "Send Mail Token".
ZEPTOMAIL_TOKEN=          # e.g. Zoho-enczapikey <long token> — paste only the token value
ZEPTOMAIL_API_URL=        # optional; default https://api.zeptomail.com/v1.1/email (.eu for EU DC)
#
# Alternative: classic SMTP (only if the host allows outbound 587/465).
SMTP_HOST=                # e.g. smtppro.zoho.com, smtp.gmail.com, email-smtp.<region>.amazonaws.com
SMTP_PORT=587             # 587 (STARTTLS) or 465 (implicit TLS)
SMTP_SECURE=              # "true" for port 465; leave empty for 587
SMTP_USER=                # SMTP username / full email address
SMTP_PASS=                # SMTP password or app-password (Gmail/Zoho: create an App Password)
MAIL_FROM=                # From: address — must be a verified sender, e.g. info@ehiveglobal.com
LEAD_NOTIFY_EMAIL=        # Where new-lead alerts go (defaults to OWNER_EMAIL)

# ── Payments (Stripe) — optional. Leave blank to disable online join. ──
# When set, self-serve tiers (Horizon/Ascent/Vanguard) can be joined and paid
# online; membership activates automatically once payment clears.
STRIPE_SECRET_KEY=        # sk_live_… or sk_test_…
STRIPE_WEBHOOK_SECRET=    # whsec_… — from the Stripe webhook endpoint (see DEPLOY.md)

# ── Bundled MySQL (docker-compose only; ignore if using a managed DB) ──
MYSQL_DATABASE=ehive      # Database name created in the db container
MYSQL_USER=ehive          # Application DB user
MYSQL_PASSWORD=           # Password for MYSQL_USER (used in DATABASE_URL)
MYSQL_ROOT_PASSWORD=      # MySQL root password
APP_PORT=3000             # Host port to expose the app on
